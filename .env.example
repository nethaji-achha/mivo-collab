# =============================================================================
# MIVO COLLAB — Environment Variables Configuration
# Connect • Collaborate • Communicate
# =============================================================================

# Server Ports
PORT_WEB=3000
PORT_API=4000
PORT_SIGNALING=4001
PORT_WORKER=4002

# Public Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SIGNALING_URL=http://localhost:4001

# Databases & Cache
DATABASE_URL=postgres://mivo_user:mivo_secure_password_2026@localhost:5432/mivo_collab
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=mivo_collab_super_secret_jwt_key_2026
SESSION_COOKIE_NAME=mivo_session
CORS_ORIGIN=http://localhost:3000

# WebRTC SFU / Media Infrastructure
RTC_MEDIA_SERVER=livekit # or 'mediasoup' | 'coturn'
RTC_API_KEY=mivo_dev_rtc_api_key
RTC_API_SECRET=mivo_dev_rtc_api_secret
TURN_SERVER_URL=turn:turn.mivo.collab:3478
TURN_USERNAME=mivo_turn_user
TURN_PASSWORD=mivo_turn_secret_password

# Object Storage (S3 / Cloudflare R2 for Avatars & Recordings)
STORAGE_ENDPOINT=https://s3.us-east-1.amazonaws.com
STORAGE_BUCKET=mivo-collab-media-assets
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# SaaS Payments (Stripe / Razorpay)
PAYMENT_PROVIDER=stripe
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email & Notifications (Resend / SendGrid / Postmark)
EMAIL_PROVIDER_KEY=re_...
EMAIL_FROM_ADDRESS=notifications@mivo.collab

# Telemetry & Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# AI Processing Engine (Transcription & Meeting Summaries)
AI_PROVIDER_KEY=
